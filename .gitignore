# Environment blocks
.env
.env.*
!.env.example
*.pem
*.key

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
db/*
db/*.db
!db/.gitkeep

# User uploads
static/uploads/*
!static/uploads/.gitkeep

# Generated files
/static/sitemap.xml
/static/images/friperi-section-*.svg
/static/images/.section-svg-*


# Backups
backups/
*.bak

# IDE and development tools
.idea/
.vscode/
.junie/
/.ollamassist/

# Build and distribution
build/
dist/
*.egg-info/

# Logs and test coverage
*.log
.coverage
htmlcov/

# Operating system files
.DS_Store
Thumbs.db
.agents
.aws
.codex
# User applications protected by Privileges
/user_files/*
!/user_files/.gitkeep

# Root verification files managed by the application
/root_files/*
!/root_files/.gitkeep
